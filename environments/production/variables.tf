# --- Image Gallery -------------------------------------------------------------
# The base image and the gallery itself are SHARED with lib-main-infra and owned
# by that repo. Only the app image definition below belongs to this project.
# See README.md > Shared base image.

variable "use_gallery_image" {
  description = "Use image from Azure Compute Gallery (false uses marketplace Rocky Linux)"
  type        = bool
  default     = false
}

variable "gallery_name" {
  description = "Name of the shared Azure Compute Gallery (owned by lib-main-infra)"
  type        = string
  default     = ""
}

variable "gallery_resource_group_name" {
  description = "Resource group containing the shared Azure Compute Gallery (owned by lib-main-infra)"
  type        = string
  default     = ""
}

variable "image_name" {
  description = "Name of this project's app image definition in the shared gallery"
  type        = string
  default     = "volumes-rocky-linux-9"
}

variable "image_version" {
  description = <<-EOT
    Version of the app image to deploy, e.g. 0.0.7, or the literal "latest" to
    resolve the newest version published to the gallery.

    Deliberately has NO default, and is deliberately absent from
    terraform.tfvars. In mccarthy-infra it once defaulted to "1.0.0" while
    tfvars pinned "0.0.4", the vanilla bootstrap image, so any manual apply that
    forgot -var would have reimaged production three builds backwards from a
    plan that looked entirely normal. A missing value stops Terraform and asks;
    a stale value says nothing. Same reasoning, and the same fix, as
    packer/variables.pkr.hcl's base_image_version.

    Every CI path passes this explicitly -- deploy-on-main-merge.yml and
    deploy-production.yml are the only two that touch this environment.

    See also check "image_version_is_newest" in main.tf, which warns when this
    is not the newest published version.
  EOT
  type        = string

  validation {
    condition     = can(regex("^([0-9]+\\.[0-9]+\\.[0-9]+|latest)$", var.image_version))
    error_message = "image_version must be a three-part version such as 0.0.7, or the literal \"latest\"."
  }
}

# --- Networking ----------------------------------------------------------------
#
# This VNet is a SPOKE. The hub is the Asimov AKS cluster, which hosts SolrCloud
# and which every library Drupal site is expected to peer with. This site does
# not peer yet -- it has no search -- but the range is allocated now so that
# adding the peering later is not also a re-address. Azure rejects peering
# between VNets with overlapping address space, and -- less obviously -- the AKS
# *service* CIDR must not overlap a peered spoke either, or reply traffic to a
# VM gets intercepted by kube-proxy as a ClusterIP.
#
# Reserved, do NOT allocate from these:
#   10.0.0.0/16     Asimov Kubernetes service CIDR (immutable)
#   10.1.0.0/16     vireo-db spoke (10.1.0.0/24 + 10.1.1.0/24), already peered
#   10.224.0.0/12   Asimov AKS node VNet
#   10.244.0.0/16   Asimov pod CIDR (Azure CNI overlay)
#   172.16.0.0/16   dns-test-rg
#
# Allocated: 10.10.0.0/16 mccarthy, 10.11.0.0/16 volumes (this repo),
# 10.20.0.0/16 lib-main. See README.md > VNet address allocation.
variable "vnet_address_space" {
  description = "Address space for the VNet. Must not overlap any other spoke or the Asimov reserved ranges."
  type        = list(string)
  default     = ["10.11.0.0/16"]
}

variable "web_subnet_prefix" {
  description = "Address prefix for the web subnet"
  type        = string
  default     = "10.11.1.0/24"
}

variable "private_endpoints_prefix" {
  description = "Address prefix for private endpoints subnet"
  type        = string
  default     = "10.11.2.0/24"
}

variable "allowed_ssh_cidr_blocks" {
  description = "CIDR blocks allowed for SSH access"
  type        = list(string)
  default = [
    "160.36.0.0/16",   # UTK campus wired
    "10.65.0.0/16",    # UTK VPN
    "10.46.0.0/15",    # UTK mod1 (10.46.x.x and 10.47.x.x)
    "216.96.128.0/17", # UTK eduroam
    "192.249.1.0/24",  # UTK campus (new range, verify exact CIDR)
  ]
}

