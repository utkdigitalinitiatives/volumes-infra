# Drupal configuration
variable "drupal_admin_password" {
  description = "Password for the Drupal admin user"
  type        = string
  sensitive   = true
  default     = null # If not provided, a random password will be generated
}

variable "drupal_site_uuid" {
  description = <<-EOT
    Fixed Drupal site UUID for config sync. MUST equal the `uuid` in the app
    repo's config/system.site.yml.

    Do not generate a fresh one: the value already exists, created when the site
    was first installed and captured by `drush config:export`. Drupal refuses to
    import config whose source UUID differs from the target site's, so cloud-init
    installs a throwaway site and immediately overwrites its UUID with this value
    before running config:import. If the app repo is ever reinstalled and
    re-exported the UUID changes and this must change with it.
  EOT
  type        = string
  # No default - must be read from the app repo, per site.
}

variable "drupal_install_profile" {
  description = <<-EOT
    Drupal install profile used for the first-boot `drush site:install`.

    MUST equal the `profile:` key in the app repo's config/core.extension.yml.
    Drupal will not let config import change the install profile, so a mismatch
    fails config:import on the first production boot -- the one boot where the
    database is empty and site:install actually runs.

    volumes uses `minimal`; lib-main uses `standard`.
  EOT
  type        = string
  default     = "minimal"
}

# --- First-boot install identity ------------------------------------------------
# Used only by the first-boot `drush site:install`, the one boot where the
# database is empty. Defaults are the volumes devs' choices (2026-10-14).
#
# The site name and site mail also live in the app repo's config/system.site.yml,
# which config:import re-asserts on every later boot, so keep the two in step.
# The admin account's username and mail are content, not config: nothing
# re-asserts them, so changing these after the first install does nothing.
#
# All four are written inside double quotes in a shell script, so the
# validations reject anything that could break out of them.

variable "drupal_site_name" {
  description = "Site name for the first-boot site:install. Must match `name` in the app repo's config/system.site.yml."
  type        = string
  default     = "Volumes | UTK Libraries"

  validation {
    condition     = can(regex("^[^\"$`\\\\]+$", var.drupal_site_name))
    error_message = "drupal_site_name must not contain a double quote, $, backtick or backslash."
  }
}

variable "drupal_site_mail" {
  description = "Site email address for the first-boot site:install. Must match `mail` in the app repo's config/system.site.yml."
  type        = string
  default     = "librarieswebsite@utk.edu"

  validation {
    condition     = can(regex("^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+$", var.drupal_site_mail))
    error_message = "drupal_site_mail must be a plain email address."
  }
}

variable "drupal_admin_username" {
  description = "Username of the super user (uid 1) created by the first-boot site:install."
  type        = string
  default     = "admin"

  validation {
    condition     = can(regex("^[A-Za-z0-9._@-]+$", var.drupal_admin_username))
    error_message = "drupal_admin_username may contain only letters, digits, '.', '_', '@' and '-'."
  }
}

variable "drupal_admin_mail" {
  description = "Email address of the super user (uid 1) created by the first-boot site:install."
  type        = string
  default     = "librarieswebsite@utk.edu"

  validation {
    condition     = can(regex("^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+$", var.drupal_admin_mail))
    error_message = "drupal_admin_mail must be a plain email address."
  }
}

variable "domain_name" {
  description = "Domain name for TLS certificate (e.g., libdev1.lib.utk.edu)"
  type        = string
  default     = null
}

variable "public_ip_id" {
  description = "Existing Azure public IP resource ID for the Load Balancer. If null, a new IP is created."
  type        = string
  default     = null
}

# --- Media SAS window ----------------------------------------------------------
# Read-only SAS handed to the Apache reverse proxy so it can serve blob media.
# Fixed dates rather than timestamp()/timeadd(), which would reissue the token on
# every plan. Roll media_sas_expiry before it lapses.

variable "media_sas_start" {
  description = "Start of the read-only media SAS validity window (RFC 3339 UTC)"
  type        = string
  default     = "2026-01-01T00:00:00Z"
}

variable "media_sas_expiry" {
  description = "Expiry of the read-only media SAS validity window (RFC 3339 UTC). Media stops being served after this date."
  type        = string
  default     = "2028-01-01T00:00:00Z"
}
